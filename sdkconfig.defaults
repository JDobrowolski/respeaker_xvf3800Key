CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y
# GPIO43/44 (domyslny UART0 konsoli) sa zajete przez I2S DIN/DOUT do XVF3800,
# wiec konsola/monitor ide przez wbudowany USB Serial/JTAG ESP32-S3.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# partycja "kws" na model slowa kluczowego
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# siec slowa kluczowego liczona ciagle na rdzeniu 1 - pelna predkosc
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# PSRAM 8 MB (XIAO ESP32-S3 = ESP32-S3R8, octal): historia mikrofonu i bufor glosnika.
# Bez PSRAM firmware tez startuje (wtedy wszystko w wewnetrznym RAM).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
